{
  "name": "leaf-disease-detection-server",
  "version": "1.0.0",
  "description": "Leaf Disease Detection API Server with Node.js wrapper for Python FastAPI",
  "main": "server.js",
  "scripts": {
    "start": "node init && node server.js",
    "dev": "node init && nodemon server.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:delete": "pm2 delete ecosystem.config.js",
    "pm2:logs": "pm2 logs",
    "pm2:monit": "pm2 monit"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "dotenv": "^16.3.1",
    "child_process": "^1.0.2",
    "http-proxy-middleware": "^2.0.6"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "keywords": [
    "leaf-disease",
    "fastapi",
    "nodejs",
    "pm2",
    "yolo",
    "machine-learning"
  ],
  "author": "Your Name",
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  }
}
